// BuildX Relational ORM Schema (Prisma)
// Demonstrates Relational Schema Design, Foreign Keys, Relations, and Enums

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CREATOR
  COLLABORATOR
  MENTOR
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SkillType {
  HAVE
  WANT
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  fullName       String
  role           Role            @default(COLLABORATOR)
  avatarUrl      String?
  bio            String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // 1:N Relations
  ownedProjects  Project[]       @relation("ProjectOwner")
  skills         UserSkill[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  memberships    ProjectMember[]

  @@index([email])
  @@index([role])
}

model UserSkill {
  id               String    @id @default(uuid())
  userId           String
  skillName        String
  proficiencyType  SkillType
  proficiencyLevel String    @default("Intermediate")
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName, proficiencyType])
  @@index([skillName, proficiencyType])
}

model Project {
  id                 String          @id @default(uuid())
  ownerId            String
  title              String
  description        String
  category           String
  status             String          @default("Planning")
  githubRepoUrl      String?
  liveDemoUrl        String?
  progressPercentage Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  owner              User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members            ProjectMember[]
  tasks              Task[]

  @@index([category, createdAt])
  @@index([ownerId])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("Developer")
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  assignedTo  String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assignedTo])
}
